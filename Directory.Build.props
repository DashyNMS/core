<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>DashyNMS</Product>
    <Company>DashyNMS</Company>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup</Copyright>
    <NeutralLanguage>en-GB</NeutralLanguage>

    <!-- The version being built towards. Development builds publish it as
         2.0.0-ci.N; the release workflow overrides it from the tag (v2.0.0). -->
    <Version>2.0.0</Version>
  </PropertyGroup>

</Project>