<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 for the desktop app, net10.0 for DashyNMS Mobile and the MCP server. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>DesktopNMS.Core</RootNamespace>
    <AssemblyName>DesktopNMS.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PackageId>DashyNMS.Core</PackageId>
    <Description>Shared LibreNMS client, models and logic for the DashyNMS apps and MCP server.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DashyNMS/core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DashyNMS/core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- The open-source licence texts both apps show (#266), by file name -
       see Licences/OpenSourceNotices.cs. A project that compiles Core's
       sources itself (mobile's DesktopNMS.Core.Portable) needs the same item. -->
  <ItemGroup>
    <EmbeddedResource Include="Licences\Texts\*.txt" LogicalName="DesktopNMS.Core.Licences.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Intelligence\Instructions\*.md" LogicalName="DesktopNMS.Core.Intelligence.Instructions.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- So request bodies built by the internal resource APIs can be checked
       key by key against a fake transport - LibreNMS applies whichever keys
       are present, so an extra or missing one is a real bug (see #169). -->
  <ItemGroup>
    <InternalsVisibleTo Include="DesktopNMS.Core.Tests" />
  </ItemGroup>

</Project>
